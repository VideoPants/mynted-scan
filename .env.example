# Database (Docker Compose default on port 5433)
DATABASE_URL="postgresql://mynted:mynted@localhost:5433/centering?schema=public"
DIRECT_URL="postgresql://mynted:mynted@localhost:5433/centering?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"
AUTH_URL="http://localhost:3000"

# Card catalogue APIs (swappable)
POKEMONTCG_API_BASE="https://api.pokemontcg.io/v2"
TCGDEX_API_BASE="https://api.tcgdex.net/v2/en"

# Optional Python measure service
CENTERING_API_URL=""

# Optional integrations
BLOB_READ_WRITE_TOKEN=""
PSA_API_TOKEN=""
KAGGLE_USERNAME=""
KAGGLE_KEY=""
ROBOFLOW_API_KEY=""

# Feature flags
NEXT_PUBLIC_FEATURE_CARD_ID=false
NEXT_PUBLIC_APP_URL="http://localhost:3000"
